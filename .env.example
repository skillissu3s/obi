# Copy to .env and fill in before `docker compose up -d`

# Encrypts stored GitHub tokens and signs sessions. Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Created on first start (and promoted to admin if the user already exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Set to 1 for one start to reset the admin password, then set back to 0
ADMIN_RESET_PASSWORD=0

# Host port to publish (container always listens on 3000)
PORT=3000

# Optional
APP_NAME=Obi
SESSION_DAYS=30
MAX_UPLOAD_MB=50
