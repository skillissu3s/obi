# Copy to .env and fill in before `docker compose up -d`

# Encrypts stored GitHub tokens and signs sessions. Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Created on first start (and promoted to admin if the user already exists).
# The email is how the admin signs in — with the password and an emailed code.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# Set to 1 for one start to reset the admin password, then set back to 0
ADMIN_RESET_PASSWORD=0

# Host port to publish (container always listens on 3000)
PORT=3000

# Optional
APP_NAME=Obi
SESSION_DAYS=30
MAX_UPLOAD_MB=50

# Photo sources for Settings -> Appearance -> Background. All optional: a source
# without its key is listed as "needs a key". Keys stay on the server.
# Bing, Wikimedia Commons, the Art Institute of Chicago, The Met and Lorem Picsum need none.
# Unsplash: https://unsplash.com/oauth/applications (the Access Key)
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/new/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Flickr: https://www.flickr.com/services/apps/create/apply/
FLICKR_API_KEY=
# Wallhaven (optional): https://wallhaven.cc/settings/account
WALLHAVEN_API_KEY=
# NASA APOD (optional, falls back to DEMO_KEY): https://api.nasa.gov/
NASA_API_KEY=
